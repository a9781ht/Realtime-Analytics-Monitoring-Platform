# ===========================================
# 即時資料分析與監控系統 - 環境變數範例
# 複製此檔為 .env 後再依實際環境調整
#   cp .env.example .env
# ===========================================

# ---------- 一般設定 ----------
PROJECT_NAME=Realtime Analytics Platform
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Taipei

# ---------- 資料庫 (MariaDB 11.7) ----------
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=analytics
DB_USER=analytics
DB_PASSWORD=analytics_pw_change_me
DB_ROOT_PASSWORD=root_pw_change_me

# SQLAlchemy 連接池設定
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ---------- JWT 認證 ----------
# 產生方式：python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=please-generate-your-own-super-secret-key-do-not-use-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- 服務埠號 ----------
BACKEND_PORT=8000
FRONTEND_PORT=8501

# ---------- CORS ----------
# 多個來源用逗號分隔
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---------- 即時資料產生器 ----------
GENERATOR_ENABLED=true
GENERATOR_INTERVAL_SECONDS=1     # 每幾秒產生一批資料
GENERATOR_BATCH_SIZE=5           # 每次產生幾筆（對應幾個感測器）
GENERATOR_FLUSH_INTERVAL=5       # 每幾秒批次寫入資料庫（時間觸發）
GENERATOR_FLUSH_SIZE=50          # 緩衝區達到幾筆立即寫入（條件觸發）

# 異常告警閾值
ALERT_THRESHOLD_HIGH=90.0
ALERT_THRESHOLD_LOW=10.0

# ---------- 預設種子帳號（僅開發用，正式環境請關閉）----------
SEED_DEMO_USERS=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@1234

# ---------- 前端 ----------
# 容器內互相呼叫使用 service name；本機直接執行請改為 http://localhost:8000
API_BASE_URL=http://backend:8000
WS_BASE_URL=ws://backend:8000
